            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password/:resetToken",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password", ":resetToken"],
              "variable": [
                {
                  "key": "resetToken",
                  "value": ""
